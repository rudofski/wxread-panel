[TEMPLATE]
# 本项目默认无需任何环境变量，直接 npm run dev 即可。
#
# 可选：访问密码门（防共用设备场景）。
# 配置后打开面板需先输入该密码；构建产物中仅含密码的 SHA-256 哈希，不含明文
# （Vite 会把 VITE_ 前缀变量内联进 JS，因此注入的是哈希而非明文密码）。
#
# 生成哈希（把「你的密码」替换为实际密码）：
#   node -e "const c=require('crypto');process.stdout.write(c.createHash('sha256').update('你的密码').digest('hex'))"
#
# VITE_PANEL_PASSWORD_HASH=<上一步输出的 64 位 hex>
