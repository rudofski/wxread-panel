{
  "manifest_version": 3,
  "name": "wxread curl_bash 获取器",
  "version": "1.0.0",
  "description": "在微信读书阅读页一键捕获真实阅读上报请求，生成含完整登录凭证（含 HttpOnly cookie：wr_vid/wr_skey/wr_rt）的 curl_bash，用于 wxread 刷时长配置",
  "permissions": ["cookies", "storage", "clipboardWrite"],
  "host_permissions": ["https://weread.qq.com/*", "https://qq.com/*", "https://*.qq.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "wxread curl_bash 获取器"
  },
  "content_scripts": [
    {
      "matches": ["https://weread.qq.com/*"],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://weread.qq.com/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
